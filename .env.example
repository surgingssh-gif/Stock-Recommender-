# Copy this file to a new file named ".env" and fill in your real keys.
# The .env file is listed in .gitignore, so it will never be uploaded to GitHub.

# From https://finnhub.io/dashboard
FINNHUB_API_KEY=paste-your-finnhub-key-here

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=paste-your-anthropic-key-here

# From Discord: Channel settings > Integrations > Webhooks > Copy Webhook URL
DISCORD_WEBHOOK_URL=paste-your-discord-webhook-url-here

# Optional: which Claude model to use (default is claude-opus-5).
# CLAUDE_MODEL=claude-sonnet-5
